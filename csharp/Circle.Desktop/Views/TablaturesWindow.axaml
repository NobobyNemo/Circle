<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Circle.Desktop.ViewModels"
        x:Class="Circle.Desktop.Views.TablaturesWindow"
        x:DataType="vm:SongsViewModel"
        Title="Табулатуры песни"
        Width="760"
        Height="520"
        MinWidth="520"
        MinHeight="320">
    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="10">
        <TextBlock Text="Табулатуры"
                   FontSize="22"
                   FontWeight="Bold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TabLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#181e26"
                                BorderBrush="#374151"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <ToggleSwitch IsChecked="{Binding IsTabTextMode}"
                                              OnContent="Текстовый редактор"
                                              OffContent="Графическое отображение" />
                                <Grid Grid.Row="1">
                                    <TextBlock Text="{Binding TabText}"
                                               IsVisible="{Binding !IsTabTextMode}"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               TextWrapping="NoWrap" />
                                    <TextBox Text="{Binding TabText, Mode=TwoWay}"
                                             IsVisible="{Binding IsTabTextMode}"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="Consolas"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
