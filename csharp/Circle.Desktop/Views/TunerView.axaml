<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Circle.Desktop.Views.TunerView"
             xmlns:vm="using:Circle.Desktop.ViewModels"
             x:DataType="vm:TunerViewModel">
    <Panel>
        <Grid RowDefinitions="Auto,*,Auto" Margin="20">
            <TextBlock Grid.Row="0"
                       Text="Guitar Tuner"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <Border Grid.Row="1"
                    Background="#181e26"
                    CornerRadius="16"
                    Padding="24"
                    Width="360"
                    Height="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Ellipse Width="300"
                             Height="300"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stroke="#4b5563"
                             StrokeThickness="4"
                             Fill="Transparent" />

                    <Path Data="M150,150 L150,30"
                          Stroke="#31d68f"
                          StrokeThickness="4"
                          StrokeLineCap="Round"
                          Width="300"
                          Height="300"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="{Binding NeedleAngle}" />
                        </Path.RenderTransform>
                    </Path>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="4">
                        <TextBlock Text="{Binding DetectedNote}"
                                   FontSize="64"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DetectedFrequency, StringFormat='{}{0:F1} Hz'}"
                                   FontSize="20"
                                   Foreground="#9ca3af"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Cents, StringFormat='{}{0:+0;-0;0} cents'}"
                                   FontSize="18"
                                   Foreground="#9ca3af"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button Grid.Row="2"
                    Content="{Binding ToggleButtonText}"
                    Command="{Binding ToggleTunerCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Padding="20,10"
                    FontSize="16"
                    FontWeight="Bold" />
        </Grid>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,8,0"
                Padding="10,8"
                Background="#1a1a2e"
                CornerRadius="8"
                BorderBrush="#333"
                BorderThickness="1"
                Width="320"
                IsVisible="{Binding !!StatusMessage}">
            <SelectableTextBlock Text="{Binding StatusMessage}"
                                 Foreground="#f87171"
                                 TextWrapping="Wrap"
                                 TextAlignment="Left"
                                 FontSize="11" />
        </Border>
    </Panel>
</UserControl>
